#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:36
msgid "Update post SEOpress schemas"
msgstr "Mettre à jour les schémas SEOpress d'une publication"

#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:43
msgid "Replaces the SEOpress Pro Custom JSON-LD schemas of a post. Sending an empty array clears all manual schemas."
msgstr "Remplace les schémas JSON-LD personnalisés SEOpress Pro d'une publication. L'envoi d'un tableau vide efface tous les schémas manuels."

#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:78
msgid "List of JSON-LD strings. Each entry is either a raw JSON object or a full <script type=\"application/ld+json\"> tag. The full list replaces any existing manual schemas."
msgstr "Liste de chaînes JSON-LD. Chaque entrée est soit un objet JSON brut, soit une balise <script type=\"application/ld+json\"> complète. La liste complète remplace tous les schémas manuels existants."

#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:136
msgid "Parameter \"schemas\" must be an array of JSON-LD strings."
msgstr "Le paramètre \"schemas\" doit être un tableau de chaînes JSON-LD."

#. translators: %d: schema index
#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:151
#, php-format
msgid "Schema #%d must be a non-empty string."
msgstr "Le schéma #%d doit être une chaîne non vide."

#. translators: %d: schema index
#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:167
#, php-format
msgid "Schema #%d must not contain a closing script tag."
msgstr "Le schéma #%d ne doit pas contenir de balise de fermeture script."

#. translators: 1: schema index, 2: json error
#: includes/Abilities/Seopress/UpdatePostSchemasAbility.php:181
#, php-format
msgid "Schema #%1$d is not valid JSON: %2$s."
msgstr "Le schéma #%1$d n'est pas un JSON valide : %2$s."

