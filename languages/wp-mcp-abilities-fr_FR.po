#: includes/Support/PostTypeAbility.php:819
#, php-format
msgid "The %s ID."
msgstr "L'ID du %s."

#: includes/Support/PostTypeAbility.php:793
msgid "Permanently delete (skip trash)."
msgstr "Supprimer définitivement (sans passer par la corbeille)."

#. translators: %s: singular label of the post type (e.g. "Post").
#: includes/Support/PostTypeAbility.php:826
#, php-format
msgid "The %s title."
msgstr "Le titre du %s."

#. translators: %s: singular label of the post type (e.g. "Post").
#: includes/Support/PostTypeAbility.php:832
#, php-format
msgid "The HTML content of the %s."
msgstr "Le contenu HTML du %s."

#. translators: %s: singular label of the post type (e.g. "Post").
#: includes/Support/PostTypeAbility.php:838
#, php-format
msgid "The %s excerpt."
msgstr "L'extrait du %s."

#: includes/Support/PostTypeAbility.php:843
msgid "The URL slug (post_name). Auto-generated from the title if omitted."
msgstr "Le slug de l'URL (post_name). Généré automatiquement à partir du titre si omis."

#: includes/Support/PostTypeAbility.php:851
msgid "The status (draft, publish)."
msgstr "Le statut (draft, publish)."

#. translators: %s: singular label of the post type (e.g. "Post").
#: includes/Support/PostTypeAbility.php:863
#, php-format
msgid "The parent %s ID."
msgstr "L'ID du %s parent."

#: includes/Support/PostTypeAbility.php:871
msgid "The IDs of categories to assign. Equivalent to the \"category\" entry of \"terms\"."
msgstr "Les identifiants des catégories à assigner. Équivaut à l'entrée « category » de « terms »."

#: includes/Support/PostTypeAbility.php:882
msgid "Term IDs to assign, keyed by taxonomy. Each taxonomy sent replaces the terms already assigned in it; a taxonomy left out is untouched, and an empty array clears it."
msgstr "Identifiants des termes à assigner, indexés par taxonomie. Chaque taxonomie envoyée remplace les termes qui y étaient déjà assignés ; une taxonomie absente n'est pas touchée, et un tableau vide la vide."

#. translators: %s: singular label of the post type (e.g. "Post").
#: includes/Support/PostTypeAbility.php:893
#, php-format
msgid "The user ID to assign as author of the %s."
msgstr "L'ID de l'utilisateur à assigner comme auteur du %s."

#: includes/Support/PostTypeAbility.php:906
msgid "The publication date (YYYY-MM-DD HH:MM:SS), in site time."
msgstr "La date de publication (AAAA-MM-JJ HH:MM:SS), à l'heure du site."

#: includes/Support/PostTypeAbility.php:912
msgid "Pin as sticky (true) or unpin (false)."
msgstr "Épingler (true) ou désépingler (false)."

#: includes/Support/PostTypeAbility.php:973
msgid "Term IDs assigned to the post, keyed by taxonomy."
msgstr "Identifiants des termes assignés au contenu, indexés par taxonomie."

#. translators: 1: taxonomy label (e.g. "Categories"), 2: taxonomy slug.
#: includes/Support/PostTypeTaxonomies.php:96
#, php-format
msgid "Term IDs in %1$s (%2$s)."
msgstr "Identifiants de termes dans %1$s (%2$s)."

#: includes/Support/PostTypeTaxonomies.php:129
msgid "Send either \"category_ids\" or the \"category\" entry of \"terms\", not both: they write the same taxonomy."
msgstr "Envoyez soit « category_ids », soit l'entrée « category » de « terms », pas les deux : ils écrivent la même taxonomie."

#: includes/Support/PostTypeTaxonomies.php:137
msgid "The \"terms\" parameter must be an object keyed by taxonomy."
msgstr "Le paramètre « terms » doit être un objet indexé par taxonomie."

#. translators: 1: taxonomy slug, 2: post type slug.
#: includes/Support/PostTypeTaxonomies.php:152
#, php-format
msgid "The \"%1$s\" taxonomy is not registered for the \"%2$s\" post type, or is not open to MCP abilities."
msgstr "La taxonomie « %1$s » n'est pas enregistrée pour le type de contenu « %2$s », ou n'est pas ouverte aux abilities MCP."

#. translators: %s: taxonomy slug.
#: includes/Support/PostTypeTaxonomies.php:165
#, php-format
msgid "The \"%s\" entry of \"terms\" must be an array of term IDs."
msgstr "L'entrée « %s » de « terms » doit être un tableau d'identifiants de termes."

#. translators: %s: taxonomy slug.
#: includes/Support/PostTypeTaxonomies.php:177
#, php-format
msgid "You are not allowed to assign terms in the \"%s\" taxonomy."
msgstr "Vous n'avez pas le droit d'assigner des termes dans la taxonomie « %s »."

#. translators: %s: taxonomy slug.
#: includes/Support/PostTypeTaxonomies.php:190
#, php-format
msgid "The \"%s\" entry of \"terms\" must only contain term IDs."
msgstr "L'entrée « %s » de « terms » ne doit contenir que des identifiants de termes."

#. translators: 1: term ID, 2: taxonomy slug.
#: includes/Support/PostTypeTaxonomies.php:202
#, php-format
msgid "Term %1$d does not exist in the \"%2$s\" taxonomy."
msgstr "Le terme %1$d n'existe pas dans la taxonomie « %2$s »."

#: includes/Support/Requirements.php:82
msgid "The Abilities API is missing."
msgstr "L'API Abilities est absente."

#. translators: 1: current WordPress version, 2: first version shipping the Abilities API.
#: includes/Support/Requirements.php:85
#, php-format
msgid "This site runs WordPress %1$s, and the Abilities API only ships with core from %2$s onwards. Updating WordPress is the way out: the feature plugin that used to provide it is now abandoned."
msgstr "Ce site utilise WordPress %1$s, or l'API Abilities n'est intégrée au cœur qu'à partir de la %2$s. La solution est de mettre WordPress à jour : le plugin dédié qui la fournissait est désormais abandonné."

#: includes/Support/Requirements.php:99
msgid "The MCP Adapter plugin is not running."
msgstr "Le plugin MCP Adapter n'est pas démarré."

#. Description of the plugin
#: wp-mcp-abilities.php
msgid "Content management abilities for AI agents, exposed through the WordPress Abilities API and the MCP Adapter."
msgstr "Abilities de gestion de contenu pour les agents IA, exposées par l'Abilities API de WordPress et le MCP Adapter."

#: includes/Hooks/RequirementsNotice.php:71
msgid "WP MCP Abilities cannot register its abilities."
msgstr "WP MCP Abilities ne peut pas enregistrer ses abilities."

#: includes/Hooks/RequirementsNotice.php:72
msgid "WP MCP Abilities is not reachable by MCP clients yet."
msgstr "WP MCP Abilities n'est pas encore joignable par les clients MCP."

#: includes/Hooks/RequirementsNotice.php:85
msgid "Download the MCP Adapter"
msgstr "Télécharger le MCP Adapter"

#: includes/Support/Requirements.php:100
msgid "The abilities are registered and available through the Abilities API, but no MCP client can reach them until the MCP Adapter is installed and active."
msgstr "Les abilities sont enregistrées et disponibles via l'Abilities API, mais aucun client MCP ne peut les joindre tant que le MCP Adapter n'est pas installé et actif."

#. translators: 1: ability name, 2: class name.
#: includes/Registry/AbilityRegistry.php:70
#, php-format
msgid "The ability \"%1$s\" was not added: abilities added on wpmcpa_register_abilities must extend %2$s."
msgstr "L'ability « %1$s » n'a pas été ajoutée : les abilities ajoutées sur wpmcpa_register_abilities doivent étendre %2$s."

#. translators: %s: ability name.
#: includes/Support/AbstractAbility.php:199
#, php-format
msgid "The wpmcpa_execute_result filter must return an array or a WP_Error; the original result of \"%s\" was kept."
msgstr "Le filtre wpmcpa_execute_result doit renvoyer un tableau ou un WP_Error ; le résultat d'origine de « %s » a été conservé."
