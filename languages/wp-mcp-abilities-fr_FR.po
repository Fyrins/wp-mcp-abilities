#: includes/Abilities/Content/ReplaceInPostContentAbility.php:59
msgid "Replace in post content"
msgstr "Remplacer dans le contenu d'une publication"

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:66
msgid "Replaces a literal string inside the content of a post, without resending the whole content. Supports a dry run and an expected number of occurrences."
msgstr "Remplace une chaîne littérale dans le contenu d'une publication, sans renvoyer tout le contenu. Prend en charge un mode simulation et un nombre d'occurrences attendu."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:76
msgid "Content"
msgstr "Contenu"

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:88
msgid "Identifier of the post to edit."
msgstr "Identifiant de la publication à modifier."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:93
msgid "Literal string to look for, matched byte for byte. Not a regular expression. Tags, attributes, HTML comments and newlines are kept as sent, so a block boundary or an opening tag with its attributes can be used as an anchor."
msgstr "Chaîne littérale à chercher, comparée octet pour octet. Ce n'est pas une expression régulière. Balises, attributs, commentaires HTML et sauts de ligne sont conservés tels qu'envoyés : une frontière de bloc ou une balise ouvrante avec ses attributs peuvent donc servir d'ancre."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:97
msgid "String to put in its place, written as sent. An empty string deletes the match."
msgstr "Chaîne à mettre à sa place, écrite telle qu'envoyée. Une chaîne vide supprime la correspondance."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:102
msgid "Number of matches the caller expects. Nothing is written when the actual count differs."
msgstr "Nombre de correspondances attendues par l'appelant. Rien n'est écrit si le nombre réel diffère."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:107
msgid "Counts and measures without writing anything."
msgstr "Compte et mesure sans rien écrire."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:125
msgid "Matches found in the content."
msgstr "Correspondances trouvées dans le contenu."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:129
msgid "True when the content was actually written."
msgstr "Vrai lorsque le contenu a réellement été écrit."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:135
msgid "Length read back from the database after writing, or the projected length on a dry run."
msgstr "Longueur relue depuis la base de données après l'écriture, ou la longueur projetée en mode simulation."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:139
msgid "False when what was stored differs from what was submitted, which points to kses having stripped markup the caller is not allowed to write."
msgstr "Faux lorsque ce qui a été stocké diffère de ce qui a été soumis, ce qui indique que kses a retiré du markup que l'appelant n'est pas autorisé à écrire."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:184
msgid "The \"search\" parameter is required."
msgstr "Le paramètre « search » est obligatoire."

#: includes/Abilities/Content/ReplaceInPostContentAbility.php:193
msgid "The \"search\" parameter was sent as an empty string. Nothing was looked for."
msgstr "Le paramètre « search » a été envoyé sous forme de chaîne vide. Rien n'a été cherché."

#. translators: 1: expected number of matches, 2: number actually found.
#: includes/Abilities/Content/ReplaceInPostContentAbility.php:214
#, php-format
msgid "%1$d matches expected, %2$d found. Nothing was written."
msgstr "%1$d correspondances attendues, %2$d trouvées. Rien n'a été écrit."

